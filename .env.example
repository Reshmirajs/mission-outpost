# ==============================================================================
# MISSION: OUTPOST - Environment Variables Template
# NASA Space Apps Challenge 2026
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to create your local environment file:
#      cp .env.example .env.local
# 2. Populate the VITE_FIREBASE_* variables below with values from your Firebase Console.
# 3. In Vite, only variables prefixed with VITE_ are exposed to the browser client.
#
# SECURITY WARNING:
# - NEVER commit .env.local, API keys, service account JSON files, or private
#   secrets into Git source control.
# - .env.local is already ignored in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Realtime Database Configuration (Person 5 Module)
# ------------------------------------------------------------------------------
# How to obtain these credentials:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Create a new Firebase project (or select an existing one).
# 3. Under "Build", click "Realtime Database" -> "Create Database".
#    Choose a database location (e.g., us-central1) and start in "test mode"
#    for local development.
# 4. In Project Settings (gear icon) -> "General" -> "Your apps", add a Web App (</>).
# 5. Copy the config parameters provided by Firebase into the variables below:

# Web API Key found in Firebase Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Auth Domain (usually: <project-id>.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Realtime Database URL found at top of Firebase Realtime Database tab
# Example format: https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# Project ID found in Project Settings > General
VITE_FIREBASE_PROJECT_ID=your_project_id

# Storage Bucket (usually: <project-id>.firebasestorage.app or .appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Messaging Sender ID found in Project Settings > Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Web App ID found in Project Settings > General > Your apps
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# NASA Open API Configuration (https://api.nasa.gov/)
# ------------------------------------------------------------------------------
# Used for real Mars InSight telemetry, Mars weather, and APOD imagery.
VITE_NASA_API_KEY=DEMO_KEY
